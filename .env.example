# 이 파일은 "어떤 비밀 값이 필요한지 이름만" 적어두는 견본이에요.
# 실제 값은 여기 적지 말고, 아래 두 곳 중 하나에 등록하세요:
#   - GitHub 레포 → Settings → Secrets and variables → Actions
#   - 또는 Vercel 프로젝트 → Settings → Environment Variables
#
# 이 .env.example 은 깃허브에 올려도 됩니다 (값이 없으니까).
# 실제 값이 든 .env 파일은 .gitignore 가 자동으로 막아줘요. 절대 올리지 마세요.
#
# 아래는 예시예요. 본인 프로젝트에 필요한 것만 남기고 이름을 바꿔 쓰세요.

# 예) 외부 서비스 토큰
# DISCORD_TOKEN=
# NOTION_TOKEN=
# OPENAI_API_KEY=

# 예) 데이터베이스 접속 정보
# DATABASE_URL=

# Supabase 브라우저 연결. publishable key만 사용하고 service_role key는 넣지 마세요.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# 선택: Google 로그인. Supabase Auth provider와 /auth/callback 허용을 마친 뒤에만 1로 켭니다.
# NEXT_PUBLIC_GOOGLE_LOGIN=0

# 선택: GA4 Measurement ID. 비워두면 이벤트는 브라우저 localStorage에만 기록됩니다.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# 선택: Microsoft Clarity 프로젝트 ID. 브라우저에서 공개로 쓰이는 식별자입니다.
# NEXT_PUBLIC_CLARITY_PROJECT_ID=

# 선택: Meta 광고 퍼널. Pixel ID는 공개 식별자이며, 아래 토큰은 반드시 서버 환경 변수로만 등록합니다.
# 설정이 없으면 Meta 스크립트와 전환 전송은 모두 no-op입니다.
# NEXT_PUBLIC_META_PIXEL_ID=
# META_DATASET_ID=
# META_CONVERSIONS_API_TOKEN=
# 선택: 미지정 시 현재 기본 지원 버전(v25.0)을 사용합니다.
# META_GRAPH_API_VERSION=v25.0
# 운영 수신 검증 중에만 Meta Test Events의 TEST 코드 값을 넣고, 검증 뒤 즉시 삭제합니다.
# META_TEST_EVENT_CODE=TEST12345

# 맛핀 Instagram 릴스·DM 수신. 아래 값은 모두 서버 환경 변수로만 등록합니다.
# Meta App Dashboard에서 설정한 App Secret과 Webhook 검증 토큰입니다.
# META_APP_SECRET=
# META_WEBHOOK_VERIFY_TOKEN=
# 연결한 Instagram Professional 계정 ID와 메시지 전송 권한이 있는 토큰입니다.
# META_INSTAGRAM_ACCOUNT_ID=
# META_INSTAGRAM_ACCESS_TOKEN=
# 사용자 ID·임시 미디어 URL 암호화/HMAC용 서로 다른 긴 임의 문자열입니다(각 32자 이상).
# MATPIN_DATA_SECRET=
# MATPIN_LINK_SECRET=
# Instagram 답장에 넣을 공개 서비스 주소입니다.
# MATPIN_PUBLIC_APP_URL=https://matpin.kr
# 실제 Meta 수신·저장 종단 간 검증 뒤에만 두 값을 함께 켭니다.
# MATPIN_INSTAGRAM_PIPELINE_MODE=mock
# NEXT_PUBLIC_MATPICK_DM_READY=false
# 선택: 장소 단서 추출은 미지정 시 저비용 gemini-3.1-flash-lite를 사용합니다.
# 기존 MATPIN_GEMINI_MODEL도 호환하지만, 새 설정에서는 역할별 변수를 권장합니다.
# MATPIN_EXTRACTION_MODEL=gemini-3.1-flash-lite
# 선택: Google Places API 키가 없을 때 지도 grounding에 사용할 모델입니다.
# MATPIN_MAPS_MODEL=gemini-3.6-flash
# MATPIN_GEMINI_MODEL=gemini-3.6-flash
# 선택: Meta CDN 도메인이 달라질 때만 쉼표로 추가합니다. 전체 허용(*)은 지원하지 않습니다.
# MATPIN_MEDIA_ALLOWED_HOSTS=cdninstagram.com,fbcdn.net,instagram.com,facebook.com

# Kakao JavaScript 키. Kakao Developers에 실제 서비스 도메인도 JavaScript SDK 도메인으로 등록하세요.
# NEXT_PUBLIC_KAKAO_JAVASCRIPT_KEY=

# 맛핀 자동 분석. 아래 키는 서버에서만 읽으며 브라우저에 노출하지 않습니다.
# GEMINI_API_KEY=
# Google Places API (New)의 Text Search를 서버에서 호출할 때 사용합니다.
# GOOGLE_MAPS_API_KEY=
# 선택: 미지정 시 gemini-3.6-flash를 사용합니다.
# TASTEPIN_GEMINI_MODEL=gemini-3.6-flash
# 선택: 식당 단서 뒤에 실제 카카오맵 장소 후보까지 연결할 때 필요합니다.
# KAKAO_REST_API_KEY=

# 로컬에서 카카오톡 공유를 시험할 때 수신자에게 보낼 공개 서비스 주소입니다.
# NEXT_PUBLIC_SITE_URL=https://bfd-seven.vercel.app

# Today 실제 1일 제작 전달. 아래 값은 모두 서버에서만 읽습니다.
# Supabase의 service_role 키는 브라우저에 절대 노출하지 마세요.
# SUPABASE_SERVICE_ROLE_KEY=
# 결과 링크 서명용 긴 임의 문자열(최소 32자)을 넣습니다.
# TODAY_LINK_SECRET=
# Resend의 Sending access 키와 검증한 발신 주소를 넣습니다.
# RESEND_API_KEY=
# TODAY_FROM_EMAIL=Today <result@your-domain.com>
# 이메일 안의 결과 링크에 사용할 공개 주소입니다.
# TODAY_PUBLIC_APP_URL=https://your-domain.com
# Vercel Cron 요청 검증용 긴 임의 문자열입니다.
# CRON_SECRET=
# 로컬·스테이징 검사에서만 대기 시간을 줄일 때 사용합니다. 운영 기본값은 86400초입니다.
# TODAY_JOB_DELAY_SECONDS=86400
