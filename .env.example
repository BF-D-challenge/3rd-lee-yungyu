# 맛핀 환경 변수 이름만 적는 견본입니다.
# 실제 값은 로컬 .env 또는 Vercel Environment Variables에만 등록하세요.
# 비밀값이 든 .env 파일은 저장소에 올리지 않습니다.

# Supabase
# 운영 프로젝트의 실제 값은 Vercel Production scope에만 등록합니다.
# Preview는 별도 격리 프로젝트의 공개 키를 쓰거나 Supabase 연결을 비워 두세요.
# 브라우저와 서버 인증에 쓰는 공개 연결 정보입니다.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
# 서버에서 별도 이름을 쓸 때만 아래 별칭을 등록합니다.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# 서버 전용 키입니다. NEXT_PUBLIC_ 접두사를 붙이지 말고 운영 값은 Production scope에만 둡니다.
# Preview에 운영 service role key를 복사하지 않습니다.
# SUPABASE_SERVICE_ROLE_KEY=
# 기존 공개 제품에서 Google 로그인을 사용할 때만 1로 설정합니다.
# NEXT_PUBLIC_GOOGLE_LOGIN=0

# 관리자 Google 로그인
# Supabase Google provider를 켜고 운영 origin의 /auth/callback을 Redirect URLs에 등록합니다.
# 맛핀 관리자는 위 Supabase 공개 연결 정보와 아래 허용목록만 사용합니다.
# 확인된 Google 이메일만 쉼표로 등록합니다. 비어 있으면 관리자 접근을 모두 거부합니다.
# MATPIN_ADMIN_EMAILS=owner@example.com

# Meta Instagram
# 실제 운영 앱과 계정의 비밀값, 계정 ID와 토큰은 Production scope에만 등록합니다.
# Preview는 별도 테스트 앱을 쓰거나 모두 비워 두고 mock 모드로 격리합니다.
# META_GRAPH_API_VERSION=v25.0
# META_APP_SECRET=
# META_WEBHOOK_VERIFY_TOKEN=
# META_INSTAGRAM_ACCOUNT_ID=
# META_INSTAGRAM_ACCESS_TOKEN=

# 공개 제품 분석과 Meta 전환 측정
# 값이 없으면 해당 브라우저 스크립트와 서버 전환 전송은 동작하지 않습니다.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_CLARITY_PROJECT_ID=
# NEXT_PUBLIC_META_PIXEL_ID=
# META_DATASET_ID=
# META_CONVERSIONS_API_TOKEN=
# 운영 수신 검증 중에만 사용하고 확인 뒤 제거합니다.
# META_TEST_EVENT_CODE=TEST12345

# 맛핀 데이터 보호와 공개 주소
# 사용자 식별값 암호화와 링크 서명에는 서로 다른 32자 이상의 값을 사용합니다.
# 운영 MATPIN_DATA_SECRET과 MATPIN_LINK_SECRET은 Production scope에만 두고 Preview에 복사하지 않습니다.
# MATPIN_DATA_SECRET=
# MATPIN_LINK_SECRET=
# MATPIN_PUBLIC_APP_URL=https://matpin-kr.vercel.app

# 처리 파이프라인
# mock은 로컬 개발과 Vercel Preview 전용입니다. live는 Vercel Production에서만 허용됩니다.
# 운영 중지는 서명된 Webhook에 503을 반환하는 maintenance를 사용합니다.
# 값이 없거나 알 수 없는 값, mock/Production 또는 live/Preview 조합도 503으로 닫힙니다.
# MATPIN_INSTAGRAM_PIPELINE_MODE=mock
# NEXT_PUBLIC_MATPICK_DM_READY=false
# 일일 fallback과 Supabase 30초 poller의 작업 호출 인증용 서버 전용 값입니다.
# 운영 CRON_SECRET은 Vercel Production과 운영 Supabase Vault에만 같은 값으로 등록하고
# Preview, 로컬 .env와 Git에는 복사하지 않습니다.
# CRON_SECRET=

# AI 장소 분석
# GEMINI_API_KEY=
# ALLSALE_GEMINI_API_KEY=
# MATPIN_EXTRACTION_MODEL=gemini-3.1-flash-lite
# MATPIN_MAPS_MODEL=gemini-3.6-flash
# 이전 단일 모델 설정과의 호환이 필요할 때만 사용합니다.
# MATPIN_GEMINI_MODEL=gemini-3.6-flash
# Meta CDN 도메인이 바뀔 때만 추가하며 전체 허용 값은 사용하지 않습니다.
# MATPIN_MEDIA_ALLOWED_HOSTS=cdninstagram.com,fbcdn.net,instagram.com,facebook.com

# 장소 확인
# GOOGLE_MAPS_API_KEY=
# KAKAO_REST_API_KEY=

# 기존 공개 제품과 공유 기능에 남아 있는 선택 설정
# NEXT_PUBLIC_KAKAO_JAVASCRIPT_KEY=
# NEXT_PUBLIC_SITE_URL=https://bfd-seven.vercel.app
# ONEBITE_GEMINI_MODEL=gemini-3.6-flash
# TASTEPIN_GEMINI_MODEL=gemini-3.6-flash
# TODAY_GEMINI_MODEL=gemini-3.6-flash

# 오늘 해볼까 1일 제작 전달 기능
# TODAY_LINK_SECRET=
# RESEND_API_KEY=
# TODAY_FROM_EMAIL=Today <result@your-domain.com>
# TODAY_PUBLIC_APP_URL=https://your-domain.com
# TODAY_JOB_DELAY_SECONDS=86400
